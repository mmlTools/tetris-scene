autoload -Uz log_error log_status log_info log_group mkcd

if (( ! ${+project_root} )) {
  log_error "'project_root' not set. Please set before running ${0}."
  return 2
}

if (( ! ${+target} )) {
  log_error "'target' not set. Please set before running ${0}."
  return 2
}

pushd ${project_root}

typeset -g QT_VERSION

# Minimum OBS Studio version the plugin is built against (keep in sync with buildspec.json)
local -r obs_minimum_version='33.0.0'

local -a apt_args=(
  ${CI:+-y}
  --no-install-recommends
)
if (( _loglevel == 0 )) apt_args+=(--quiet)

_apt_update() {
  for attempt in {1..3}; do
    if sudo apt-get update; then
      return 0
    fi
    sleep $(( attempt * 10 ))
  done
  return 1
}

if (( ! (${skips[(Ie)all]} + ${skips[(Ie)deps]}) )) {
  log_group 'Installing obs-studio build dependencies...'

  if [[ ${CPUTYPE} != "${target##*-}" ]] {
    sudo apt-get install ${apt_args} gcc-${${target##*-}//_/-}-linux-gnu g++-${${target##*-}//_/-}-linux-gnu
  }

  # Distribution obs-studio/libobs-dev packages lag behind (Ubuntu 26.04 ships 32.x): always build against
  # the official OBS Studio PPA, which ships libobs headers and CMake package files in its obs-studio package.
  # The PPA is registered explicitly with its own keyring (add-apt-repository can leave it unsigned, which
  # makes apt silently ignore it) and pinned above the distribution archive.
  local -r ppa_url='https://ppa.launchpadcontent.net/obsproject/obs-studio/ubuntu'
  local -r ppa_keyring='/etc/apt/keyrings/obsproject-obs-studio.gpg'
  local codename
  codename="$(. /etc/os-release && print -r -- ${VERSION_CODENAME})"

  sudo mkdir -p /etc/apt/keyrings /etc/apt/preferences.d

  local fingerprint
  for attempt in {1..3}; do
    fingerprint="$(curl -fsSL https://api.launchpad.net/1.0/~obsproject/+archive/ubuntu/obs-studio | jq -r '.signing_key_fingerprint')" && \
      [[ ${fingerprint} =~ '^[0-9A-F]{40}$' ]] && \
      curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0x${fingerprint}" \
        | sudo gpg --batch --yes --dearmor -o ${ppa_keyring} && break
    fingerprint=''
    sleep $(( attempt * 15 ))
  done

  if [[ -z ${fingerprint} ]] {
    log_error 'Could not fetch the obsproject PPA signing key.'
    return 2
  }

  print -r -- "Types: deb
URIs: ${ppa_url}
Suites: ${codename}
Components: main
Signed-By: ${ppa_keyring}" | sudo tee /etc/apt/sources.list.d/obsproject-obs-studio.sources >/dev/null
  print -r -- "Package: *
Pin: release o=LP-PPA-obsproject-obs-studio
Pin-Priority: 1001" | sudo tee /etc/apt/preferences.d/obsproject-obs-studio >/dev/null

  if ! _apt_update; then
    log_error 'apt-get update failed after adding the obsproject PPA.'
    return 2
  fi

  apt-cache policy obs-studio

  local ppa_version
  ppa_version="$(apt-cache madison obs-studio | awk -F'|' '/launchpadcontent|obsproject/ && !v { gsub(/ /, "", $2); v = $2 } END { print v }')"
  if [[ -z ${ppa_version} ]] {
    log_error "The obsproject PPA has no obs-studio package for Ubuntu '${codename}'."
    return 2
  }

  # Never mix the distribution's libobs-dev with the PPA build
  if dpkg -s libobs-dev >/dev/null 2>&1; then
    sudo apt-get remove ${apt_args} libobs-dev
  fi

  sudo apt-get install ${apt_args} --allow-downgrades \
    build-essential \
    libgles2-mesa-dev \
    libsimde-dev \
    obs-studio=${ppa_version}

  local obs_version
  obs_version="$(dpkg-query -W -f='${Version}' obs-studio 2>/dev/null)"
  obs_version="${${obs_version#*:}%%-*}"

  autoload -Uz is-at-least
  if [[ -z ${obs_version} ]] || ! is-at-least ${obs_minimum_version} ${obs_version}; then
    log_error "OBS Studio ${obs_minimum_version}+ is required, but the PPA provided '${obs_version}' for Ubuntu '${codename}'. Use an Ubuntu release the OBS PPA ships OBS ${obs_minimum_version%%.*} for (ubuntu-26.04 or newer)."
    return 2
  fi
  log_info "Building against OBS Studio ${obs_version} (${ppa_version})"
  log_group
}
