autoload -Uz log_error log_status log_info log_group mkcd

if (( ! ${+project_root} )) {
  log_error "'project_root' not set. Please set before running ${0}."
  return 2
}

if (( ! ${+target} )) {
  log_error "'target' not set. Please set before running ${0}."
  return 2
}

pushd ${project_root}

typeset -g QT_VERSION

# Minimum OBS Studio version the plugin is built against (keep in sync with buildspec.json)
local -r obs_minimum_version='33.0.0'

local -a apt_args=(
  ${CI:+-y}
  --no-install-recommends
)
if (( _loglevel == 0 )) apt_args+=(--quiet)

_apt_update() {
  for attempt in {1..3}; do
    if sudo apt-get update; then
      return 0
    fi
    sleep $(( attempt * 10 ))
  done
  return 1
}

if (( ! (${skips[(Ie)all]} + ${skips[(Ie)deps]}) )) {
  log_group 'Installing obs-studio build dependencies...'

  if [[ ${CPUTYPE} != "${target##*-}" ]] {
    sudo apt-get install ${apt_args} gcc-${${target##*-}//_/-}-linux-gnu g++-${${target##*-}//_/-}-linux-gnu
  }

  # Distribution libobs-dev packages lag behind: always build against the official OBS Studio PPA,
  # which ships libobs headers and CMake package files inside the obs-studio package.
  local ppa_added=0
  for attempt in {1..3}; do
    if sudo add-apt-repository --yes ppa:obsproject/obs-studio; then
      ppa_added=1
      break
    fi
    sleep $(( attempt * 15 ))
  done

  if (( ! ppa_added )) {
    log_error 'Could not add the obsproject PPA after retries.'
    return 2
  }

  if ! _apt_update; then
    log_error 'apt-get update failed after adding the obsproject PPA.'
    return 2
  fi

  # Never mix the distribution's libobs-dev with the PPA build
  if dpkg -s libobs-dev >/dev/null 2>&1; then
    sudo apt-get remove ${apt_args} libobs-dev
  fi

  sudo apt-get install ${apt_args} \
    build-essential \
    libgles2-mesa-dev \
    libsimde-dev \
    obs-studio

  local obs_version
  obs_version="$(dpkg-query -W -f='${Version}' obs-studio 2>/dev/null)"
  obs_version="${${obs_version#*:}%%-*}"

  autoload -Uz is-at-least
  if [[ -z ${obs_version} ]] || ! is-at-least ${obs_minimum_version} ${obs_version}; then
    log_error "OBS Studio ${obs_minimum_version}+ is required, but the PPA provided '${obs_version}'. Use an Ubuntu release supported by the OBS PPA for OBS ${obs_minimum_version%%.*} (e.g. ubuntu-26.04)."
    return 2
  fi
  log_info "Building against OBS Studio ${obs_version}"
  log_group
}
